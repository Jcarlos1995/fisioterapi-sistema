rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Datos clínicos: solo usuarios autenticados
    match /patients/{id} {
      allow read, write: if request.auth != null;
    }

    match /professionals/{id} {
      allow read, write: if request.auth != null;
    }

    match /sessions/{id} {
      allow read, write: if request.auth != null;
    }

    match /products/{id} {
      allow read, write: if request.auth != null;
    }

    match /userRoles/{id} {
      allow read, write: if request.auth != null;
    }

    // Stories: lectura pública (landing las muestra), escritura autenticada
    match /stories/{id} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // Config del panel (ej: liveEvent): lectura pública (landing la consume),
    // escritura solo para staff autenticado (EventsManager en el panel).
    match /config/{docId} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // Rate limiting: solo el Admin SDK (Cloud Functions) puede escribir aquí
    match /bookingRateLimits/{id} {
      allow read, write: if false;
    }

    // Notificaciones de cancelación: lectura solo staff autenticado.
    // Escritura únicamente por Admin SDK desde Cloud Functions.
    match /cancellationNotifications/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Rate limiting del login del portal de pacientes (solo Admin SDK).
    match /patientLoginRateLimits/{id} {
      allow read, write: if false;
    }

    // Plantilla global de tareas (permanente): solo staff autenticado
    match /therapyTasks/{id} {
      allow read, write: if request.auth != null;
    }

    // Registro diario de tareas por paciente: solo staff autenticado
    match /therapyPatientTasks/{id} {
      allow read, write: if request.auth != null;
    }

    // Precios de servicios: solo staff autenticado
    match /servicePrices/{id} {
      allow read, write: if request.auth != null;
    }

    // Registro de ventas: solo staff autenticado
    match /sales/{id} {
      allow read, write: if request.auth != null;
    }

    // Colección legacy — se mantiene por compatibilidad histórica
    match /therapyLogs/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Logs de auditoría (Ley 29733): solo staff autenticado puede leer y crear.
    // Nunca se actualiza ni elimina desde el cliente (inmutables).
    match /auditLogs/{id} {
      allow read:          if request.auth != null;
      allow create:        if request.auth != null;
      allow update, delete: if false;
    }

    // Cualquier otra colección: denegar por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
