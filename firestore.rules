rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Datos clínicos: solo usuarios autenticados
    match /patients/{id} {
      allow read, write: if request.auth != null;
    }

    match /professionals/{id} {
      allow read, write: if request.auth != null;
    }

    match /sessions/{id} {
      allow read, write: if request.auth != null;
    }

    match /products/{id} {
      allow read, write: if request.auth != null;
    }

    match /userRoles/{id} {
      allow read, write: if request.auth != null;
    }

    // Stories: lectura pública (landing las muestra), escritura autenticada
    match /stories/{id} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // Rate limiting: solo el Admin SDK (Cloud Functions) puede escribir aquí
    match /bookingRateLimits/{id} {
      allow read, write: if false;
    }

    // Cualquier otra colección: denegar por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
