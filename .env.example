# reCAPTCHA v3 (clave de sitio — pública, obtenla en https://www.google.com/recaptcha/admin)
VITE_RECAPTCHA_SITE_KEY=tu_recaptcha_v3_site_key

# Gemini (sistema autónomo)
VITE_GEMINI_API_KEY=tu_gemini_api_key_aqui

# Firebase - (obtén estos valores en Firebase Console > Configuración del proyecto)
VITE_FIREBASE_API_KEY=tu_firebase_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu_proyecto_id
VITE_FIREBASE_STORAGE_BUCKET=tu_proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
VITE_FIREBASE_APP_ID=tu_app_id
VITE_FIREBASE_MEASUREMENT_ID=tu_measurement_id
